# Runtime Environment (local, staging, production)
DJANGO_ENV=local

# Security: Generate a secure 50+ character random secret key for production
SECRET_KEY=change-me-to-a-secure-random-secret-key-min-32-chars

# PostgreSQL Database Connection String (e.g., Neon Serverless or Local Postgres)
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database_name>?sslmode=require

# Application Debug Mode (Set to False in production)
DEBUG=True

# Comma-separated or JSON list of allowed host domains
ALLOWED_HOSTS=["127.0.0.1","localhost"]